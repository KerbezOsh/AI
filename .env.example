# ── NVIDIA NIM ───────────────────────────────────────────────────────
# Ключ можно не хранить здесь, а один раз сохранить в интерфейсе (data/key.json).
# Env-ключ используется, только если ключа ещё нет в настройках.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI-совместимый endpoint NVIDIA.
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Цепочки моделей: основная, затем резервы через запятую.
# При 429/503/таймауте запрос автоматически уходит на следующую модель.
# Замеры первого токена: lightning ~0.5 с, ultra ~0.7 с, minimax ~2 с,
# kimi-k3.1-pro ~78 с. Медленные — только резервом.
NVIDIA_FLASH_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,minimaxai/minimax-m3.1-flash
NVIDIA_PRO_MODELS=nvidia/nemotron-3-ultra-550b-a55b,mistralai/mistral-large-4-1t-a52b,moonshotai/kimi-k3.1-pro
NVIDIA_VISION_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b

# Дешёвая модель для фоновых задач: заголовки и память чата.
NVIDIA_UTILITY_MODEL=minimaxai/minimax-m3.1-flash

# ── Параметры генерации ──────────────────────────────────────────────
# top_p: 0.95 — часть моделей NVIDIA NIM фиксирует это значение.
# off/none отключает параметр и не отправляет его в запрос.
NVIDIA_TEMPERATURE_FLASH=0.4
NVIDIA_TOP_P_FLASH=0.95
NVIDIA_MAX_TOKENS_FLASH=4096
NVIDIA_TEMPERATURE_PRO=0.25
NVIDIA_TOP_P_PRO=0.95
NVIDIA_MAX_TOKENS_PRO=8192
# Дополнительные токены для Reasoning и общий потолок (0 — без потолка).
# Рассуждения и ответ делят один лимит: если модель думает дольше, ответа не остаётся.
NVIDIA_DEEP_EXTRA_TOKENS=4096
NVIDIA_MAX_TOKENS_CAP=16384
# 1 — разрешить рассуждения во всех режимах (медленнее, часто пустой ответ).
NVIDIA_THINKING=

# Таймауты в мс (минимум 5000). Меньше — быстрее уходим на резервную модель.
# CONNECT — сколько ждём заголовки ответа; IDLE — допустимая пауза посреди потока.
# Думающая модель может молчать 40–60 с перед первым токеном: не ставь мало.
NVIDIA_CONNECT_TIMEOUT_MS=60000
NVIDIA_IDLE_TIMEOUT_MS=90000
# Задаёт оба таймаута сразу, если отдельные не указаны.
NVIDIA_TIMEOUT_MS=

# Сколько раз переспросить другую модель, если вместо ответа пришёл отказ
# («I cannot provide…», «я не могу…»). Отказ обрывается на середине и на экран
# не попадает. 3 — четыре попытки разными моделями; со второй попытки в контекст
# идут примеры ответов, чтобы перебить шаблон отказа. 0 — выключить переспрос.
NVIDIA_REFUSAL_RETRIES=3

# Сколько последних сообщений держать в контексте (12–15).
CHAT_HISTORY_MESSAGES=14

# ── Веб-поиск (необязательно) ────────────────────────────────────────
# Без ключей используется DuckDuckGo; ключи дают более стабильную выдачу.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Хранилище и доступ ───────────────────────────────────────────────
# Если задан — состояние хранится в Postgres, иначе в data/*.json.
DATABASE_URL=

# Почты администраторов через запятую.
ADMIN_EMAIL=

# Только для локального server.js.
PORT=7331
